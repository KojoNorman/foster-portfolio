---
import type { Venture } from '../content/siteData';

interface Props {
  venture: Venture;
}

const { venture } = Astro.props;

const statusStyles: Record<Venture['status'], string> = {
  Active: 'bg-forest text-ivory border-forest',
  'In development': 'bg-sage/75 text-forest border-forest/20',
  Prototype: 'bg-ivory text-charcoal border-stone',
  Concept: 'bg-ivory text-olive border-stone',
};

const dotStyles: Record<Venture['status'], string> = {
  Active: 'bg-brass',
  'In development': 'bg-forest',
  Prototype: 'bg-brass',
  Concept: 'bg-olive',
};
---

<article
  class:list={[
    'card-editorial relative overflow-hidden flex flex-col justify-between',
    venture.featured
      ? 'lg:col-span-2 border-forest/40 p-6 sm:p-8 lg:p-9'
      : 'p-6 sm:p-7',
  ]}
>
  <!-- Top Accent Bar for Featured Venture -->
  {venture.featured && (
    <div class="absolute top-0 left-0 right-0 h-1.5 bg-forest" aria-hidden="true"></div>
  )}

  <div>
    <!-- Row 1: Monogram Badge on Left + Locked Status Badge on Right (Prevents uneven line wrapping) -->
    <div class="flex items-center justify-between gap-3 mb-4">
      <div class="flex items-center gap-3">
        <div
          class:list={[
            'w-10 h-10 rounded-xl border flex items-center justify-center font-mono text-xs font-semibold shrink-0',
            venture.featured
              ? 'bg-forest text-ivory border-forest'
              : 'bg-ivory text-forest border-stone',
          ]}
          aria-hidden="true"
        >
          {venture.monogram}
        </div>

        {venture.featured && (
          <span class="inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-wider bg-ivory border border-brass/40 text-charcoal px-2.5 py-1 rounded-md font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-brass"></span>
            Featured Venture
          </span>
        )}
      </div>

      <!-- Status Pill (Never wraps awkwardly below category) -->
      <span
        class:list={[
          'inline-flex items-center gap-1.5 font-mono text-xs px-3 py-1 rounded-full border font-medium shrink-0',
          statusStyles[venture.status],
        ]}
      >
        <span class:list={['w-1.5 h-1.5 rounded-full', dotStyles[venture.status]]} aria-hidden="true"></span>
        <span>Status: {venture.status}</span>
      </span>
    </div>

    <!-- Row 2: Consistent Category Eyebrow -->
    <div class="flex items-center gap-2 mb-2">
      <span class="w-3 h-[2px] bg-brass shrink-0" aria-hidden="true"></span>
      <span class="font-mono text-xs uppercase tracking-wider text-olive">
        {venture.category}
      </span>
    </div>

    <!-- Row 3: Venture Title & Proposition -->
    <h3 class="font-heading font-bold text-xl sm:text-2xl text-charcoal mb-2">
      {venture.name}
    </h3>
    <p class="text-[15px] sm:text-base font-medium text-forest mb-3 leading-snug">
      {venture.proposition}
    </p>
    <p class="text-sm sm:text-[15px] text-olive leading-relaxed mb-6">
      {venture.description}
    </p>

    <!-- Row 4: Structured Problem & Beneficiaries Box -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 p-4 rounded-xl bg-ivory/70 border border-stone/80 text-sm mb-6">
      <div>
        <span class="font-mono text-[11px] uppercase tracking-wider text-charcoal font-semibold block mb-1">
          Problem Addressed
        </span>
        <p class="text-olive text-xs sm:text-sm leading-relaxed">
          {venture.problemAddressed}
        </p>
      </div>
      <div class="sm:border-l sm:border-stone sm:pl-4">
        <span class="font-mono text-[11px] uppercase tracking-wider text-charcoal font-semibold block mb-1">
          Intended Beneficiaries
        </span>
        <p class="text-olive text-xs sm:text-sm leading-relaxed">
          {venture.beneficiaries}
        </p>
      </div>
    </div>
  </div>

  <!-- Row 5: Footer Tags & Action Link -->
  <div class="pt-4 border-t border-stone flex flex-wrap items-center justify-between gap-4">
    <ul class="flex flex-wrap gap-1.5" aria-label={`Topics for ${venture.name}`}>
      {venture.tags.map((tag) => (
        <li class="font-mono text-[11px] bg-ivory text-olive px-2.5 py-1 rounded-md border border-stone">
          {tag}
        </li>
      ))}
    </ul>

    <a
      href="#connect"
      data-venture-name={venture.name}
      class="venture-discuss-link group inline-flex items-center text-sm font-semibold text-forest hover:text-forest-dark py-1 shrink-0"
    >
      <span>{venture.ctaLabel}</span>
      <svg
        class="w-4 h-4 ml-1.5 transition-transform group-hover:translate-x-1 text-brass"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>
  </div>
</article>
