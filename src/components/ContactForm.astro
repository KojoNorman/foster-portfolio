---
import { siteData } from '../content/siteData';
const { connectSection, profile, formDelivery } = siteData;
---

<section id="connect" class="section-spacing">
  <div class="container-editorial">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
      <!-- Left Column: Headline, 4 Numbered Contact Paths & Direct Outreach Buttons -->
      <div class="lg:col-span-5 space-y-7">
        <div>
          <span class="font-mono text-xs uppercase tracking-widest text-brass block mb-2">
            {connectSection.sectionNumber} / Connect
          </span>
          <h2 class="font-heading font-semibold text-3xl sm:text-4xl text-charcoal mb-3">
            {connectSection.headline}
          </h2>
          <p class="text-base text-olive leading-relaxed">
            {connectSection.supportingCopy}
          </p>
        </div>

        <div class="space-y-2.5">
          <p class="font-mono text-xs uppercase tracking-wider text-charcoal font-semibold">
            Ways We Can Engage
          </p>
          <div class="grid grid-cols-1 gap-2.5">
            {connectSection.paths.map((path, index) => (
              <div class="bg-surface border border-stone rounded-xl p-3.5 sm:p-4 flex items-start gap-3.5 hover:border-brass/60 transition-colors">
                <span class="font-mono text-xs font-semibold text-brass bg-ivory border border-stone px-2 py-1 rounded-md shrink-0 mt-0.5">
                  0{index + 1}
                </span>
                <div>
                  <h3 class="font-heading font-semibold text-sm sm:text-[15px] text-charcoal">
                    {path.title}
                  </h3>
                  <p class="text-xs sm:text-sm text-olive mt-0.5 leading-relaxed">
                    {path.description}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="pt-4 border-t border-stone space-y-3">
          <p class="font-mono text-xs uppercase tracking-wider text-olive">
            Prefer Direct Outreach?
          </p>
          <div class="flex flex-wrap items-center gap-3">
            <a
              href={`mailto:${profile.email}`}
              class="inline-flex items-center gap-2 bg-surface hover:bg-sage/40 border border-stone hover:border-forest/40 text-charcoal text-xs sm:text-sm font-medium px-4 py-2.5 rounded-xl transition-colors min-h-[42px]"
            >
              <svg class="w-4 h-4 text-brass shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span>{profile.email}</span>
            </a>

            <a
              href={profile.linkedinUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-surface hover:bg-sage/40 border border-stone hover:border-forest/40 text-charcoal text-xs sm:text-sm font-medium px-4 py-2.5 rounded-xl transition-colors min-h-[42px]"
            >
              <svg class="w-4 h-4 text-forest shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" />
              </svg>
              <span>LinkedIn Profile</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Sticky Dual-Delivery Contact Form -->
      <div class="lg:col-span-7 lg:sticky lg:top-24">
        <div class="card-editorial border-t-4 border-t-forest p-6 sm:p-9">
          <div class="mb-6 pb-4 border-b border-stone">
            <h3 class="font-heading font-semibold text-xl text-charcoal">
              Send a direct message
            </h3>
            <p class="text-xs sm:text-sm text-olive mt-1">
              Select a topic below or click any venture above to pre-fill your enquiry.
            </p>
          </div>

          <form
            id="portfolio-contact-form"
            name="foster-portfolio-contact"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            data-web3forms-key={formDelivery?.web3FormsAccessKey || ''}
            data-emailjs-service={formDelivery?.emailJsServiceId || ''}
            data-emailjs-template={formDelivery?.emailJsTemplateId || ''}
            data-emailjs-public={formDelivery?.emailJsPublicKey || ''}
            class="space-y-5"
          >
            <input type="hidden" name="form-name" value="foster-portfolio-contact" />
            <input
              type="hidden"
              id="form-subject"
              name="subject"
              value="[Portfolio Enquiry] New message for Foster Normanyo"
            />

            <p class="hidden" aria-hidden="true">
              <label>
                Don’t fill this out if you’re human: <input id="bot-field" name="bot-field" />
              </label>
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class="block text-sm font-medium text-charcoal mb-1.5">
                  Name <span class="text-brass" aria-hidden="true">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  autocomplete="name"
                  placeholder="Your full name"
                  class="w-full rounded-xl border border-stone bg-ivory/60 px-4 py-3 text-sm text-charcoal placeholder:text-olive/70 focus:bg-surface focus:border-forest transition-colors"
                />
              </div>

              <div>
                <label for="email" class="block text-sm font-medium text-charcoal mb-1.5">
                  Email address <span class="text-brass" aria-hidden="true">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  autocomplete="email"
                  placeholder="you@organisation.com"
                  class="w-full rounded-xl border border-stone bg-ivory/60 px-4 py-3 text-sm text-charcoal placeholder:text-olive/70 focus:bg-surface focus:border-forest transition-colors"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="organisation" class="block text-sm font-medium text-charcoal mb-1.5">
                  Organisation or role <span class="text-olive font-normal">(optional)</span>
                </label>
                <input
                  type="text"
                  id="organisation"
                  name="organisation"
                  autocomplete="organization"
                  placeholder="University, company, or role"
                  class="w-full rounded-xl border border-stone bg-ivory/60 px-4 py-3 text-sm text-charcoal placeholder:text-olive/70 focus:bg-surface focus:border-forest transition-colors"
                />
              </div>

              <div>
                <label for="reason" class="block text-sm font-medium text-charcoal mb-1.5">
                  Reason for reaching out <span class="text-brass" aria-hidden="true">*</span>
                </label>
                <select
                  id="reason"
                  name="reason"
                  required
                  class="w-full rounded-xl border border-stone bg-ivory/60 px-4 py-3 text-sm text-charcoal focus:bg-surface focus:border-forest transition-colors"
                >
                  <option value="" disabled selected>Select a topic...</option>
                  <option value="Mentorship and professional guidance">Mentorship and professional guidance</option>
                  <option value="Scholarships and postgraduate opportunities">Scholarships and postgraduate opportunities</option>
                  <option value="Venture collaboration">Venture collaboration</option>
                  <option value="Speaking and other professional enquiries">Speaking and other professional enquiries</option>
                  <option value="Other">Other</option>
                </select>
              </div>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-charcoal mb-1.5">
                Message <span class="text-brass" aria-hidden="true">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                placeholder="How can we connect or collaborate?"
                class="w-full rounded-xl border border-stone bg-ivory/60 px-4 py-3 text-sm text-charcoal placeholder:text-olive/70 focus:bg-surface focus:border-forest transition-colors"
              ></textarea>
            </div>

            <div
              id="form-success"
              role="status"
              aria-live="polite"
              class="hidden rounded-xl bg-sage border border-forest/30 p-4 text-sm text-forest"
            >
              <strong>Thank you for reaching out.</strong> Your message has been received. I will review it and respond shortly.
            </div>

            <div
              id="form-error"
              role="alert"
              aria-live="assertive"
              class="hidden rounded-xl bg-ivory border border-brass p-4 text-sm text-charcoal"
            >
              <strong>We could not send your message automatically.</strong> Please check your connection or email me directly at <a href={`mailto:${profile.email}`} class="underline font-medium text-forest">{profile.email}</a>.
            </div>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-1">
              <button
                id="submit-btn"
                type="submit"
                class="w-full sm:w-auto inline-flex items-center justify-center bg-forest text-ivory hover:bg-forest-dark font-medium text-sm sm:text-base px-8 py-3.5 rounded-xl transition-colors min-h-[48px] shadow-sm"
              >
                Send a message
              </button>
              <span class="font-mono text-xs text-olive">
                Direct response within 24–48 hrs
              </span>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const ventureLinks = document.querySelectorAll('.venture-discuss-link');
  const reasonSelect = document.getElementById('reason') as HTMLSelectElement | null;
  const messageInput = document.getElementById('message') as HTMLTextAreaElement | null;
  const subjectInput = document.getElementById('form-subject') as HTMLInputElement | null;
  const nameInput = document.getElementById('name') as HTMLInputElement | null;
  const emailInput = document.getElementById('email') as HTMLInputElement | null;
  const orgInput = document.getElementById('organisation') as HTMLInputElement | null;
  const botInput = document.getElementById('bot-field') as HTMLInputElement | null;

  ventureLinks.forEach((link) => {
    link.addEventListener('click', () => {
      const ventureName = link.getAttribute('data-venture-name');
      if (reasonSelect) {
        reasonSelect.value = 'Venture collaboration';
      }
      if (messageInput && ventureName && !messageInput.value.trim()) {
        messageInput.value = `Hi Foster, I would like to discuss ${ventureName} with you.`;
      }
    });
  });

  const form = document.getElementById('portfolio-contact-form') as HTMLFormElement | null;
  const successBox = document.getElementById('form-success');
  const errorBox = document.getElementById('form-error');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  if (form && successBox && errorBox && submitBtn) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      // Stop spam bots if honeypot field is filled
      if (botInput && botInput.value) {
        return;
      }

      successBox.classList.add('hidden');
      errorBox.classList.add('hidden');
      submitBtn.disabled = true;
      const originalText = submitBtn.textContent;
      submitBtn.textContent = 'Sending...';

      const senderName = nameInput?.value.trim() || 'Website Visitor';
      const senderEmail = emailInput?.value.trim() || '';
      const senderOrg = orgInput?.value.trim() || 'Not specified';
      const selectedReason = reasonSelect?.value || 'General Enquiry';
      const messageText = messageInput?.value.trim() || '';
      const dynamicSubject = `[Portfolio: ${selectedReason}] from ${senderName}${senderOrg !== 'Not specified' ? ` (${senderOrg})` : ''}`;

      if (subjectInput) {
        subjectInput.value = dynamicSubject;
      }

      const web3Key = form.getAttribute('data-web3forms-key') || '';
      const emailJsService = form.getAttribute('data-emailjs-service') || '';
      const emailJsTemplate = form.getAttribute('data-emailjs-template') || '';
      const emailJsPublic = form.getAttribute('data-emailjs-public') || '';

      try {
        const requests: Promise<Response>[] = [];

        // 1. Always save submission to Netlify Forms database
        const formData = new FormData(form);
        const urlEncodedBody = new URLSearchParams(formData as unknown as Record<string, string>).toString();
        requests.push(
          fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: urlEncodedBody,
          })
        );

        // 2. Option A: Send instant free email via Web3Forms if key is configured
        if (web3Key) {
          requests.push(
            fetch('https://api.web3forms.com/submit', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                Accept: 'application/json',
              },
              body: JSON.stringify({
                access_key: web3Key,
                subject: dynamicSubject,
                from_name: 'Foster Normanyo Portfolio',
                name: senderName,
                email: senderEmail,
                organisation: senderOrg,
                reason: selectedReason,
                message: messageText,
              }),
            })
          );
        }

        // 3. Option B: Send instant free email via EmailJS REST API if credentials are configured
        if (emailJsService && emailJsTemplate && emailJsPublic) {
          requests.push(
            fetch('https://api.emailjs.com/api/v1.0/email/send', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                service_id: emailJsService,
                template_id: emailJsTemplate,
                user_id: emailJsPublic,
                template_params: {
                  subject: dynamicSubject,
                  from_name: senderName,
                  from_email: senderEmail,
                  organisation: senderOrg,
                  reason: selectedReason,
                  message: messageText,
                },
              }),
            })
          );
        }

        const results = await Promise.allSettled(requests);
        const anySucceeded = results.some(
          (res) => res.status === 'fulfilled' && res.value.ok
        );

        if (anySucceeded) {
          form.reset();
          successBox.classList.remove('hidden');
          const win = window as unknown as { trackPortfolioEvent?: (e: string, d: Record<string, string>) => void };
          if (typeof win.trackPortfolioEvent === 'function') {
            win.trackPortfolioEvent('contact_form_submitted', { reason: selectedReason });
          }
        } else {
          errorBox.classList.remove('hidden');
        }
      } catch {
        errorBox.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
    });
  }
</script>
