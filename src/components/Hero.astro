---
import { siteData } from '../content/siteData';
const { profile } = siteData;
---

<section id="top" class="bg-forest text-ivory border-b border-forest-dark relative overflow-hidden">
  <div class="container-editorial py-10 sm:py-12 lg:py-14">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
      <!-- Left Column: Identity, Headline, CTAs & Availability Line -->
      <div class="lg:col-span-7 space-y-5">
        <div class="inline-flex items-center gap-2.5 px-3 py-1 rounded-full bg-forest-dark/80 border border-sage/15">
          <span class="w-2 h-2 rounded-full bg-brass" aria-hidden="true"></span>
          <p class="font-mono text-xs tracking-widest uppercase text-sage">
            {profile.eyebrow}
          </p>
        </div>

        <h1 class="font-heading font-semibold text-[34px] sm:text-[44px] lg:text-[50px] leading-[1.1] tracking-tight text-ivory max-w-[18ch]">
          {profile.heroHeadline}
        </h1>

        <p class="text-base sm:text-[17px] text-sage/90 leading-relaxed max-w-xl">
          {profile.heroSupporting}
        </p>

        <!-- Primary & Secondary CTAs -->
        <div class="pt-1 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5">
          <a
            href="#ventures"
            class="group inline-flex items-center justify-center bg-ivory text-forest hover:bg-sage font-medium text-sm sm:text-base px-6 py-3 rounded-xl transition-colors min-h-[46px] shadow-sm"
          >
            <span>Explore my ventures</span>
            <svg
              class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>

          <a
            href="#connect"
            class="inline-flex items-center justify-center border border-sage/35 text-ivory hover:bg-forest-dark hover:border-brass font-medium text-sm sm:text-base px-6 py-3 rounded-xl transition-colors min-h-[46px]"
          >
            Let's connect
          </a>
        </div>

        <!-- Subtle Action-Oriented Availability Line for Convening Delegates -->
        <div class="pt-2 flex items-center gap-2.5 text-xs sm:text-sm text-sage/95">
          <span class="w-2 h-2 rounded-full bg-brass shrink-0" aria-hidden="true"></span>
          <p class="font-medium">
            {profile.availabilityLine}
          </p>
        </div>

        <!-- Quick Credibility Strip -->
        <div class="pt-3 border-t border-sage/15 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-mono text-sage/80">
          <span>B.Tech Marketing (First Class)</span>
          <span class="text-brass" aria-hidden="true">·</span>
          <span>2x Salesforce Certified</span>
          <span class="text-brass" aria-hidden="true">·</span>
          <span>Accra, Ghana</span>
        </div>
      </div>

      <!-- Right Column: Editorial Framed Portrait -->
      <div class="lg:col-span-5">
        <div class="relative mx-auto max-w-[340px] sm:max-w-[370px] lg:max-w-[390px]">
          <div
            class="absolute -inset-2 rounded-2xl border border-brass/30 translate-x-2 translate-y-2 pointer-events-none hidden sm:block"
            aria-hidden="true"
          ></div>

          <figure class="relative rounded-2xl overflow-hidden border border-sage/25 bg-forest-dark shadow-lg p-2.5 sm:p-3">
            <div class="rounded-xl overflow-hidden bg-ivory border border-stone">
              <img
                src={profile.portraitPath}
                alt={profile.portraitAlt}
                width="520"
                height="560"
                loading="eager"
                decoding="async"
                class="w-full h-auto aspect-[4/4.3] object-cover object-top"
              />
            </div>
            <figcaption class="pt-3 px-2 pb-1 flex items-center justify-between">
              <span class="font-mono text-[11px] sm:text-xs tracking-wide text-sage">
                {profile.portraitLabel}
              </span>
              <span class="inline-flex items-center gap-1.5 font-mono text-[11px] text-brass">
                <span class="w-2 h-2 rounded-full bg-brass" aria-hidden="true"></span>
                Accra
              </span>
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </div>
</section>
