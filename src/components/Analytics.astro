---
import { siteData } from '../content/siteData';
const { analytics } = siteData;
---

{analytics.enabled && (
  <>
    {/* Official Umami Cloud Script Tag with First-Party Proxy Fallback */}
    {analytics.provider === 'umami' && analytics.websiteId && (
      <script
        is:inline
        defer
        src={analytics.scriptUrl}
        data-website-id={analytics.websiteId}
        onload="console.info('[Portfolio Analytics]: Umami script loaded and active.');"
        onerror="console.warn('[Portfolio Analytics]: Direct Umami script blocked by browser shield; switching to first-party proxy...'); var s = document.createElement('script'); s.defer = true; s.src = '/stats/script.js'; s.setAttribute('data-website-id', this.getAttribute('data-website-id')); s.setAttribute('data-host-url', '/stats'); document.head.appendChild(s);"
      ></script>
    )}

    {/* Plausible Analytics Loader */}
    {analytics.provider === 'plausible' && (
      <script
        is:inline
        defer
        data-domain={analytics.domain}
        src="https://plausible.io/js/script.js"
      ></script>
    )}

    {/* GoatCounter Analytics Loader */}
    {analytics.provider === 'goatcounter' && analytics.websiteId && (
      <script
        is:inline
        async
        data-goatcounter={`https://${analytics.websiteId}.goatcounter.com/count`}
        src="//gc.zgo.at/count.js"
      ></script>
    )}

    {/* Custom Portfolio Interaction Event Tracker */}
    <script
      is:inline
      define:vars={{
        debugConsoleLogs: analytics.debugOnLocalhost,
      }}
    >
      (function () {
        function trackPortfolioEvent(eventName, eventData) {
          if (debugConsoleLogs) {
            console.info('[Portfolio Analytics -> Umami Event]:', eventName, eventData || {});
          }

          if (typeof window.umami !== 'undefined' && typeof window.umami.track === 'function') {
            window.umami.track(eventName, eventData);
          }

          if (typeof window.plausible === 'function') {
            window.plausible(eventName, { props: eventData });
          }

          if (typeof window.goatcounter !== 'undefined' && typeof window.goatcounter.count === 'function') {
            window.goatcounter.count({
              path: 'event-' + eventName + (eventData && eventData.item ? '-' + eventData.item : ''),
              title: eventName,
              event: true,
            });
          }
        }

        window.trackPortfolioEvent = trackPortfolioEvent;

        document.addEventListener('DOMContentLoaded', function () {
          document.querySelectorAll('.venture-discuss-link').forEach(function (link) {
            link.addEventListener('click', function () {
              const ventureName = link.getAttribute('data-venture-name') || 'Unknown';
              trackPortfolioEvent('venture_interest_click', { venture: ventureName });
            });
          });

          document.querySelectorAll('a[href$=".pdf"]').forEach(function (link) {
            link.addEventListener('click', function () {
              trackPortfolioEvent('cv_download', { file: 'foster-normanyo-cv.pdf' });
            });
          });

          document.querySelectorAll('a[href^="mailto:"]').forEach(function (link) {
            link.addEventListener('click', function () {
              trackPortfolioEvent('direct_email_click', { channel: 'email' });
            });
          });

          document.querySelectorAll('a[href*="linkedin.com"]').forEach(function (link) {
            link.addEventListener('click', function () {
              trackPortfolioEvent('linkedin_profile_click', { channel: 'linkedin' });
            });
          });
        });
      })();
    </script>
  </>
)}
