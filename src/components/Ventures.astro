---
import { siteData } from '../content/siteData';
import VentureCard from './VentureCard.astro';

const { venturesSection } = siteData;
const primaryVentures = venturesSection.ventures.filter((v) => v.tier === 'primary');
const explorationVentures = venturesSection.ventures.filter((v) => v.tier === 'exploration');
---

<section id="ventures" class="section-spacing border-b border-stone">
  <div class="container-editorial space-y-14">
    <!-- Primary Ventures Section -->
    <div>
      <div class="max-w-2xl mb-9 sm:mb-11">
        <span class="font-mono text-xs uppercase tracking-widest text-brass block mb-2">
          {venturesSection.sectionNumber} / Selected Ventures (Primary Focus)
        </span>
        <h2 class="font-heading font-semibold text-3xl sm:text-4xl text-charcoal mb-4">
          {venturesSection.title}
        </h2>
        <p class="text-base sm:text-lg text-olive leading-relaxed">
          {venturesSection.intro}
        </p>
      </div>

      <!-- 3 Primary Ventures Grid (1 Featured Full-Width + 2 Below) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-7">
        {primaryVentures.map((venture) => (
          <VentureCard venture={venture} />
        ))}
      </div>
    </div>

    <!-- Secondary Exploration Subsection ("Other concepts I'm exploring") -->
    {explorationVentures.length > 0 && (
      <div class="pt-10 border-t border-stone">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-7">
          <div>
            <span class="font-mono text-xs uppercase tracking-widest text-olive block mb-1.5">
              Early-Stage Sandbox
            </span>
            <h3 class="font-heading font-semibold text-2xl sm:text-3xl text-charcoal">
              {venturesSection.otherConceptsTitle}
            </h3>
          </div>
          <p class="text-sm text-olive max-w-md">
            {venturesSection.otherConceptsIntro}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {explorationVentures.map((venture) => (
            <VentureCard venture={venture} compact={true} />
          ))}
        </div>
      </div>
    )}
  </div>
</section>
